<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="Exists('ServiceReference/FestService251.cs')">
    <DefineConstants>$(DefineConstants);FEST_TYPED_PROXY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.ServiceModel.Http" Version="10.0.652802" />
    <PackageReference Include="System.ServiceModel.Primitives" Version="10.0.652802" />
    <!-- Løfter sårbar transitiv versjon (NU1903) -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../HttpClient/FestM30Client.cs" />
    <Compile Remove="TypedProxyExample.cs" Condition="!Exists('ServiceReference/FestService251.cs')" />
  </ItemGroup>
</Project>
